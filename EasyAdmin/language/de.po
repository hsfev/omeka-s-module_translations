msgstr "Der Cache „opcache“ ist deaktiviert."

msgid "The php extension \"opcache\" is not available."
msgstr "Die PHP-Erweiterung „opcache“ ist nicht verfügbar."

msgid "An issue occurred when checking status of \"apcu\" or the status is disabled."
msgstr "Bei der Überprüfung des Status von „apcu“ ist ein Problem aufgetreten oder der Status ist deaktiviert."

msgid "The cache \"apcu\" was reset."
msgstr "Der Cache „apcu“ wurde zurückgesetzt."

msgid "The php extension \"apcu\" is not available."
msgstr "Die PHP-Erweiterung „apcu“ ist nicht verfügbar."

msgid "The cache of real paths was reset."
msgstr "Der Cache der echten Pfade wurde zurückgesetzt."

msgid "Install tasks were run without errors."
msgstr "Installationsaufgaben wurden ohne Fehler ausgeführt."

msgid "The php extension \"intl\" is not available. It is recommended to install it to translate dates."
msgstr "Die PHP-Erweiterung „intl“ ist nicht verfügbar.Es wird empfohlen, es zu installieren, um Datumsangaben zu übersetzen."

msgid "{count} tasks defined to be run automatically once a day."
msgstr "{count} Aufgaben sind so definiert, dass sie einmal täglich automatisch ausgeführt werden."

msgid "The file is a dir."
msgstr "Die Datei ist ein Verzeichnis."

msgid "Filename empty."
msgstr "Dateiname leer."

msgid "Filename too much short or long."
msgstr "Dateiname zu kurz oder zu lang."

msgid "Filename contains forbidden characters."
msgstr "Der Dateiname enthält verbotene Zeichen."

msgid "Filename has no extension."
msgstr "Der Dateiname hat keine Erweiterung."

msgid "Local path is not configured."
msgstr "Der lokale Pfad ist nicht konfiguriert."

msgid "Local path should be a sub-directory of /files."
msgstr "Der lokale Pfad sollte ein Unterverzeichnis von /files sein."

msgid "Local path cannot be a directory managed by Omeka and should be inside /files."
msgstr "Der lokale Pfad darf kein von Omeka verwaltetes Verzeichnis sein und sollte sich in /files befinden."

msgid "Local path cannot be the root directory."
msgstr "Der lokale Pfad darf nicht das Stammverzeichnis sein."

msgid "Local path is not writeable."
msgstr "Der lokale Pfad ist nicht beschreibbar."

msgid "Checks and fixes"
msgstr "Überprüfungen und Korrekturen"
