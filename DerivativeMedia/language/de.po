msgstr "Zip-Element anderer Dateien"

msgid "Pdf from images files"
msgstr "PDF aus Bilddateien"

msgid "Single text file from by-page txt files"
msgstr "Einzelne Textdatei aus seitenbezogenen TXT-Dateien"

msgid "Single text file from property \"extracted text\""
msgstr "Einzelne Textdatei aus der Eigenschaft „extrahierter Text“"

msgid "Single xml Alto from by-page xml Alto (standard ocr format, require Iiif Search)"
msgstr "Einzelnes XML Alto aus seitenweisem XML Alto (Standard-OCR-Format, erfordert Iiif-Suche)"

