msgstr "Audio"

msgid "Video"
msgstr "Video"

msgid "Zip item files"
msgstr "Artikeldateien komprimieren"

msgid "Zip item image/audio/video files"
msgstr "Bild-/Audio-/Videodateien des Elements komprimieren"

