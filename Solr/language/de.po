msgstr "Geändert"

msgid "Is public"
msgstr "Ist öffentlich"

msgid "Resource class"
msgstr "Ressourcenklasse"

msgid "Media content (html or extracted text)"
msgstr "Medieninhalte (HTML oder extrahierter Text)"

msgid "Is open"
msgstr "Ist geöffnet"

