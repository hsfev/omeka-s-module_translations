msgid "Solr module requires PHP Solr extension, which is not loaded."
msgstr "Das Solr-Modul erfordert die PHP-Solr-Erweiterung, die nicht geladen ist."

msgid "[unknown]"
msgstr "[unbekannt]"

msgid "To use advanced query options (and/or, distance max, etc.), Solr module requires PHP Solr library 2.1.0 or above (lastest recommended, current %s)."
msgstr "Um erweiterte Abfrageoptionen (und/oder maximale Entfernung usw.) zu verwenden, erfordert das Solr-Modul die PHP-Solr-Bibliothek 2.1.0 oder höher (letzte empfohlene Version, aktuell %s)."

msgid "The module \"%s\" was automatically deactivated because the dependencies are unavailable."
msgstr "Das Modul „%s“ wurde automatisch deaktiviert, da die Abhängigkeiten nicht verfügbar sind."

msgid "Relevance"
msgstr "Relevanz"

msgid "Asc"
msgstr "Aufstieg"

msgid "Desc"
msgstr "Beschr"

msgid "Mapping between property \"%s\" and Solr field \"%s\" for \"%s\""
msgstr "Zuordnung zwischen der Eigenschaft „%s“ und dem Solr-Feld „%s“ für „%s“"

msgid "WARNING"
msgstr "WARNUNG"

msgid "This will remove all references to this Solr mapping in search pages that use it (%d, of which %d are enabled for facets or sort fields)."
msgstr "Dadurch werden alle Verweise auf diese Solr-Zuordnung auf Suchseiten entfernt, die sie verwenden (%d, davon sind %d für Facetten oder Sortierfelder aktiviert)."

msgid "There is no search pages associated with this Solr mapping."
msgstr "Mit dieser Solr-Zuordnung sind keine Suchseiten verknüpft."

msgid "This will delete all search indexes (%d), all search pages (%d), and all Solr mappings (%d) that use this Solr node."
msgstr "Dadurch werden alle Suchindizes (%d), alle Suchseiten (%d) und alle Solr-Zuordnungen (%d) gelöscht, die diesen Solr-Knoten verwenden."

msgid "To keep search indexes and pages, create a new node and set it for the related indexes before deletion."
msgstr "Um Suchindizes und Seiten beizubehalten, erstellen Sie einen neuen Knoten und legen Sie ihn vor dem Löschen für die zugehörigen Indizes fest."

msgid "There is no search indexes, search pages, neither Solr mappings associated with this Solr node."
msgstr "Mit diesem Solr-Knoten sind weder Suchindizes, Suchseiten noch Solr-Zuordnungen verknüpft."

msgid "Add Solr mapping"
msgstr "Fügen Sie Solr-Mapping hinzu"

msgid "Solr nodes"
msgstr "Solr-Knoten"

msgid "Resources list for node \"%s\""
msgstr "Ressourcenliste für Knoten „%s“"

msgid "Mappings for \"%s\""
msgstr "Zuordnungen für „%s“"

msgid "Solr mappings for \"%s\""
msgstr "Solr-Zuordnungen für „%s“"

msgid "Add new mapping"
msgstr "Neue Zuordnung hinzufügen"

msgid "Add a text index to all missing and used properties."
msgstr "Fügen Sie einen Textindex zu allen fehlenden und verwendeten Eigenschaften hinzu."

msgid "Map all used properties"
msgstr "Ordnen Sie alle verwendeten Eigenschaften zu"

msgid "Remove mappings of properties that are not used."
msgstr "Entfernen Sie Zuordnungen von Eigenschaften, die nicht verwendet werden."

msgid "Remove unused properties"
msgstr "Entfernen Sie ungenutzte Eigenschaften"

msgid "Solr field"
msgstr "Solr-Feld"

