msgstr "Übersetztes Standardlabel"

msgid "There is no mappings defined yet."
msgstr "Es sind noch keine Zuordnungen definiert."

msgid "Add a new mapping"
msgstr "Fügen Sie eine neue Zuordnung hinzu"

msgid "Solr node \"%s\""
msgstr "Solr-Knoten „%s“"

msgid "Rules"
msgstr "Regeln"

msgid "Edit Solr mapping"
msgstr "Bearbeiten Sie die Solr-Zuordnung"

