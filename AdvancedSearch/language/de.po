msgstr "Besitzt Vermögen"

msgid "Has no asset"
msgstr "Hat kein Vermögen"

msgid "Presence of original file"
msgstr "Vorhandensein der Originaldatei"

msgid "Has original file"
msgstr "Originaldatei vorhanden"

msgid "Has no original file"
msgstr "Hat keine Originaldatei"

msgid "Search by media type"
msgstr "Suche nach Medientyp"

msgid "Select media types…"
msgstr "Medientypen auswählen…"

