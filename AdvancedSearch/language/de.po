msgstr "Artikelsets auswählen…"

msgid "[any property]"
msgstr "[jedes Eigentum]"

msgid "Internal [sql]"
msgstr "Intern [SQL]"

msgid "Aliases and aggregated fields"
msgstr "Aliase und aggregierte Felder"

msgid "Resource id"
msgstr "Ressourcen-ID"

msgid "No operation (noop)"
msgstr "Keine Operation (Noop)"

