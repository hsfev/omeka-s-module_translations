msgstr "[Undefiniert]"

msgid "Not implemented in this form adapter."
msgstr "In diesem Formularadapter nicht implementiert."

msgid "Api"
msgstr "API"

msgid "The search config {search_config} has no form adapter."
msgstr "Die Suchkonfiguration {search_config} hat keinen Formularadapter."

msgid "The search config {search_config} has a unavailable form adapter {form_adapter}."
msgstr "Die Suchkonfiguration {search_config} verfügt über einen nicht verfügbaren Formularadapter {form_adapter}."

msgid "Query error: {message}\nQuery: {json_query}"
msgstr "Abfragefehler: {message}\nAbfrage: {json_query}"

msgid "Select metadata…"
msgstr "Metadaten auswählen…"

msgid "The use of the view helper searchingFilters() is deprecated. Use $searchConfig->renderSearchFilters() instead."
msgstr "Die Verwendung des View-Helfers searchFilters() ist veraltet.Verwenden Sie stattdessen $searchConfig->renderSearchFilters()."

msgid "[AdvancedSearch] The facet value \"{value}\" for field \"{field}\" is skipped because it has no label or it is not in the current site."
msgstr "[AdvancedSearch] Der Facettenwert „{value}“ für das Feld „{field}“ wird übersprungen, da es keine Beschriftung hat oder sich nicht auf der aktuellen Site befindet."

msgid "For facet \"{field}\", the thesaurus is not defined. Set it as option thesaurus"
msgstr "id. = Für die Facette „{field}“ ist der Thesaurus nicht definiert.Legen Sie es als option thesaurus = id fest."

msgid "Search engine #{search_config} does not exist."
msgstr "Suchmaschine #{search_config} existiert nicht."

msgid "Search engine {name} (#{search_config}) is not available."
msgstr "Die Suchmaschine {name} (#{search_config}) ist nicht verfügbar."

msgid "Suggester #{search_suggester_id} (\"{name}\"): Only search engine with the intenal adapter (sql) can be indexed currently."
msgstr "Suggester #{search_suggester_id} (\"{name}\"): Derzeit kann nur eine Suchmaschine mit dem internen Adapter (SQL) indiziert werden."

msgid "Suggester #{search_suggester_id} (\"{name}\"): there is no resource type to index or the indexation is not needed."
msgstr "Vorschlager #{search_suggester_id} („{name}“): Es gibt keinen Ressourcentyp zum Indexieren oder die Indexierung ist nicht erforderlich."

msgid "Suggester #{search_suggester_id} (\"{name}\"): There are already {total} other jobs \"Index Suggestion\" (#{list}) and the current one is not forced."
msgstr "Vorschlager #{search_suggester_id} („{name}“): Es gibt bereits {total} andere Jobs „Indexvorschlag“ (#{list}) und der aktuelle wird nicht erzwungen."

msgid "There are already {total} other jobs \"Index Suggestions\". Slowdowns may occur on the site."
msgstr "Es gibt bereits {total} andere Jobs „Indexvorschläge“.Es kann zu Verzögerungen auf der Website kommen."

msgid "Suggester #{search_suggester_id} (\"{name}\"): start of indexing (index mode: {mode}, process mode: {mode_2})."
msgstr "Vorschlager #{search_suggester_id} („{name}“): Beginn der Indizierung (Indexmodus: {mode}, Prozessmodus: {mode_2})."

msgid "Suggester #{search_suggester_id} (\"{name}\"): end of indexing. {total} suggestions indexed. Execution time: {duration} seconds."
msgstr "Suggester #{search_suggester_id} („{name}“): Ende der Indexierung.{total} Vorschläge indexiert.Ausführungszeit: {duration} Sekunden."

msgid "Suggester #{search_suggester_id} (\"{name}\"): {total} suggestions deleted."
msgstr "Vorschlager #{search_suggester_id} („{name}“): {total} Vorschläge gelöscht."

msgid "Indexing suggestions for {total} resource values."
msgstr "Indexierungsvorschläge für {total} Ressourcenwerte."

msgid "Job stopped: {count}/{total} processed (index mode: {mode})."
msgstr "Job gestoppt: {count}/{total} verarbeitet (Indexmodus: {mode})."

msgid "{count}/{total} values processed."
msgstr "{count}/{total} Werte verarbeitet."

msgid "End of process: {count}/{total} processed (index mode: {mode})."
msgstr "Ende des Prozesses: {count}/{total} verarbeitet (Indexmodus: {mode})."

msgid "No search engine is defined to be indexed."
msgstr "Für die Indizierung ist keine Suchmaschine definiert."

msgid "No search engine is defined to index the specified resource types."
msgstr "Für die Indizierung der angegebenen Ressourcentypen ist keine Suchmaschine definiert."

msgid "Search index #{search_engine_id} (\"{name}\"): the list of resource ids contains invalid ids."
msgstr "Suchindex #{search_engine_id} („{name}“): Die Liste der Ressourcen-IDs enthält ungültige IDs."

msgid "Search index #{search_engine_id} (\"{name}\"): There are already {total} other jobs \"Index Search\" (#{list}) and the current one is not forced."
msgstr "Suchindex #{search_engine_id} („{name}“): Es gibt bereits {total} andere Jobs „Indexsuche“ (#{list}) und der aktuelle wird nicht erzwungen."

msgid "There are already {total} other jobs \"Index Search\". Slowdowns may occur on the site."
msgstr "Es gibt bereits {total} andere Jobs „Indexsuche“.Es kann zu Verzögerungen auf der Website kommen."

msgid "Reindexing starts at resource #{resource_id}."
