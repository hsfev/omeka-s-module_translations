msgstr "Bei der Ressource #{resource_id} für die Eigenschaft {property} ist mit preg_replace ein Fehler aufgetreten."

msgid "A conversion requires valid \"from\" dataType and \"to\" dataType."
msgstr "Für eine Konvertierung sind gültige Datentypen „von“ und „nach“ erforderlich."

msgid "A conversion from data type \"{datatype_1}\" to \"{datatype_2}\" requires the module Bulk Import."
msgstr "Für eine Konvertierung vom Datentyp „{datatype_1}“ in „{datatype_2}“ ist das Modul Bulk Import erforderlich."

msgid "To convert into the data type \"{datatype}\", the properties where to find the identifier should be set."
msgstr "Zur Konvertierung in den Datentyp „{datatype}“ müssen die Eigenschaften festgelegt werden, in denen der Bezeichner zu finden ist."

msgid "The conversion from data type \"{datatype_1}\" to \"{datatype_2}\" requires a site or api to create the url."
msgstr "Für die Konvertierung vom Datentyp „{datatype_1}“ in „{datatype_2}“ ist eine Website oder API zum Erstellen der URL erforderlich."

msgid "No linked resource found for resource #{resource_id}, property \"{property}\", value resource #{linked_resource_id}."
msgstr "Für Ressource #{resource_id}, Eigenschaft „{property}“, Wertressource #{linked_resource_id} wurde keine verknüpfte Ressource gefunden."

msgid "For resource #{resource_id}, property \"{property}\", the linked resource #{linked_resource_id} is not a {resource_type}, but a {resource_name}."
msgstr "Für Ressource #{resource_id}, Eigenschaft „{property}“, ist die verknüpfte Ressource #{linked_resource_id} kein {resource_type}, sondern ein {resource_name}."

msgid "No linked resource found with properties {properties} for resource #{resource_id}, property \"{property}\", identifier \"{identifier}\"."
