msgid "Ghostscript is not available."
msgstr "Ghostscript ist nicht verfügbar."

msgid "The command \"pdftoppm\" (poppler) or \"gs\" (ghostscript) should be available to convert pdf to images."
msgstr "Zum Konvertieren von PDF in Bilder sollte der Befehl „pdftoppm“ (Poppler) oder „gs“ (Ghostscript) verfügbar sein."

msgid "The command \"gs\" (ghostscript) will be used to convert pdf to images."
msgstr "Der Befehl „gs“ (Ghostscript) wird verwendet, um PDF in Bilder zu konvertieren."

msgid "The command \"pdftoppm\" (poppler) will be used to convert pdf to images."
msgstr "Der Befehl „pdftoppm“ (poppler) wird zum Konvertieren von PDF in Bilder verwendet."

msgid "The command \"gs\" (ghostscript) is not available to convert pdf to images."
msgstr "Der Befehl „gs“ (Ghostscript) ist zum Konvertieren von PDFs in Bilder nicht verfügbar."

msgid "The command \"pdftoppm\" (poppler) is not available to convert pdf to images."
msgstr "Der Befehl „pdftoppm“ (poppler) ist zum Konvertieren von PDF in Bilder nicht verfügbar."

msgid "Unable to create temp directory \"{dir}\" for item #{item_id}."
msgstr "Das temporäre Verzeichnis „{dir}“ für Element #{item_id} kann nicht erstellt werden."

msgid "Unable to create temp directory \"{dir}\" inside \"/files\" for resource #{resource_id}."
msgstr "Das temporäre Verzeichnis „{dir}“ in „/files“ für die Ressource #{resource_id} kann nicht erstellt werden."

msgid "Unable to read pdf #{media_id}."
msgstr "PDF #{media_id} kann nicht gelesen werden."

msgid "Step 1/2 for item #{item_id}, pdf #{media_id}: Extracting pages as image."
msgstr "Schritt 1/2 für Artikel #{item_id}, pdf #{media_id}: Seiten als Bild extrahieren."

msgid "Unable to extract images from item #{item_id} pdf #{media_id}."
msgstr "Bilder aus Element #{item_id} pdf #{media_id} können nicht extrahiert werden."

msgid "For item #{item_id}, pdf #{media_id} cannot be exploded into images."
msgstr "Für Artikel #{item_id} kann PDF #{media_id} nicht in Bilder zerlegt werden."

msgid "Step 2/2 for item #{item_id}, pdf #{media_id}: Creating {total} media."
msgstr "Schritt 2/2 für Artikel #{item_id}, pdf #{media_id}: {total} Medien erstellen."

msgid "File cannot be saved in temporary directory \"{dir}\" (temp file: \"{file}\")"
msgstr "Datei kann nicht im temporären Verzeichnis „{dir}“ gespeichert werden (temporäre Datei: „{file}“)"

msgid "Update media html: Invalid regex."
msgstr "Medien-HTML aktualisieren: Ungültiger regulärer Ausdruck."

msgid "An error occurred on resource #{resource_id} for html with preg_replace."
msgstr "Bei Ressource #{resource_id} für HTML ist mit preg_replace ein Fehler aufgetreten."

msgid "An error occurred on media #{media_id} (item #{item_id}) for source with preg_replace."
msgstr "Auf Medium #{media_id} (Element #{item_id}) für Quelle mit preg_replace ist ein Fehler aufgetreten."

msgid "The provided uri \"{uri}\" is not trimmed."
msgstr "Die bereitgestellte URI „{uri}“ wird nicht gekürzt."

msgid "The label for uri \"{uri}\" is \"{value}\"."
msgstr "Die Bezeichnung für uri „{uri}“ ist „{value}“."

msgid "The label for uri \"{uri}\" was not found."
msgstr "Die Bezeichnung für URI „{uri}“ wurde nicht gefunden."

msgid "The provided label \"{label}\" is not trimmed."
msgstr "Das bereitgestellte Label „{label}“ wird nicht gekürzt."

msgid "Connection error when fetching url \"{url}\": {exception}"
msgstr "Verbindungsfehler beim Abrufen der URL „{url}“: {Ausnahme}"

msgid "Connection issue when fetching url \"{url}\": {message}"
msgstr "Verbindungsproblem beim Abrufen der URL „{url}“: {message}"

msgid "Output is empty for url \"{url}\"."
msgstr "Die Ausgabe für die URL „{url}“ ist leer."

msgid "Output is not xml for url \"{url}\"."
msgstr "Die Ausgabe ist kein XML für die URL „{url}“."

msgid "Output is not a valid xml for url \"{url}\"."
msgstr "Die Ausgabe ist keine gültige XML-Datei für die URL „{url}“."

msgid "The directory \"{path}\" is not writeable."
msgstr "Das Verzeichnis „{path}“ ist nicht beschreibbar."

msgid "The directory \"{path}\" is not writeable: {error}."
msgstr "Das Verzeichnis „{path}“ ist nicht beschreibbar: {error}."

msgid "Batch edit"
msgstr "Stapelbearbeitung"

msgid "The actions are processed in the order of the form. Be careful when mixing them."
msgstr "Die Aktionen werden in der Reihenfolge des Formulars abgearbeitet.Seien Sie beim Mischen vorsichtig."

msgid "To convert values to/from mapping markers, use module DataTypeGeometry."
msgstr "Um Werte in/von Zuordnungsmarkierungen zu konvertieren, verwenden Sie das Modul DataTypeGeometry."

msgid "Processes that manage files and remote data can be slow, so it is recommended to process it in background with \"batch edit all\", not \"batch edit selected\"."
msgstr "Prozesse, die Dateien und Remote-Daten verwalten, können langsam sein. Daher wird empfohlen, sie im Hintergrund mit „Alles im Stapel bearbeiten“ und nicht mit „Ausgewählte im Stapel bearbeiten“ zu verarbeiten."
