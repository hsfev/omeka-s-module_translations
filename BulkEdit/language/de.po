msgid "Argument \"wrap\" of method %1$s must be a null or alphanumeric string, received unstringable object \"%2$s\"."
msgstr "Das Argument „wrap“ der Methode %1$s muss eine Null- oder alphanumerische Zeichenfolge sein, das empfangene, nicht stringfähige Objekt „%2$s“."

