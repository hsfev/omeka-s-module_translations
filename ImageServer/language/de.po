msgid "The module %1$s should be upgraded to version %2$s or later."
msgstr "Das Modul %1$s sollte auf Version %2$s oder höher aktualisiert werden."

msgid "This module requires the module \"%s\", version %s or above."
msgstr "Dieses Modul erfordert das Modul „%s“, Version %s oder höher."

msgid "Error directory non writable: \"%s\"."
msgstr "Fehlerverzeichnis nicht beschreibbar: „%s“."

msgid "Failed to create folder \"%s\": a file with the same name exists…"
msgstr "Fehler beim Erstellen des Ordners „%s“: Es existiert eine Datei mit demselben Namen…"

msgid "Error making directory: \"%s\"."
msgstr "Fehler beim Erstellen des Verzeichnisses: „%s“."

msgid "OpenSeadragon is not available unless JavaScript is enabled."
msgstr "OpenSeadragon ist nur verfügbar, wenn JavaScript aktiviert ist."

msgid "Now, all images can be automatically converted into tiles and an option in settings and site settings allows to specify the default display.\nIt can be selected directly in the theme too (thumbnail \"tile\").\nThe conversion of the renderer from \"tile\" to the standard \"file\" can be done with the job in the config form."
msgstr "Jetzt können alle Bilder automatisch in Kacheln umgewandelt werden und eine Option in den Einstellungen und Site-Einstellungen ermöglicht es, die Standardanzeige festzulegen.\nEs kann auch direkt im Theme ausgewählt werden (Miniaturansicht „Kachel“).\nDie Konvertierung des Renderers von „Kachel“ in die Standard-Datei „Datei“ kann mit dem Job im Konfigurationsformular erfolgen."

msgid "Storing tile info for images in background (%1$sjob #%2$d%3$s, %4$slogs%3$s). This process will take a while."
msgstr "Kachelinformationen für Bilder im Hintergrund speichern (%1$job #%2$d%3$s, %4$slots%3s).Dieser Vorgang wird eine Weile dauern."

msgid "The routes to the image server have been renamed from \"iiif-img/\" and \"ixif-media/\" to the more standard \"iiif/\"."
msgstr "Die Routen zum Bildserver wurden von „iiif-img/“ und „ixif-media/“ in das standardmäßigere „iiif/“ umbenannt."

msgid "Check the config of the module."
msgstr "Überprüfen Sie die Konfiguration des Moduls."

msgid "The tile dir is not defined."
msgstr "Das Kachelverzeichnis ist nicht definiert."

msgid "The directory \"{directory}\" is not writeable."
msgstr "Das Verzeichnis „{directory}“ ist nicht beschreibbar."

msgid "The tiles will be saved in the directory \"{dir}\"."
msgstr "Die Kacheln werden im Verzeichnis „{dir}“ gespeichert."

msgid "The tile dir is not defined and was not removed."
msgstr "Das Kachelverzeichnis ist nicht definiert und wurde nicht entfernt."

msgid "The tile dir \"{dir}\" is not a real path and was not removed."
msgstr "Das Kachelverzeichnis „{dir}“ ist kein echter Pfad und wurde nicht entfernt."

msgid "The tile dir is not defined and won’t be removed."
msgstr "Das Kachelverzeichnis ist nicht definiert und wird nicht entfernt."

msgid "All tiles will be removed!"
msgstr "Alle Kacheln werden entfernt!"

msgid "The tile dir \"{dir}\" is not a real path and cannot be removed."
msgstr "Das Kachelverzeichnis „{dir}“ ist kein echter Pfad und kann nicht entfernt werden."

msgid "WARNING"
msgstr "WARNUNG"

msgid "To keep the tiles, rename the dir \"{dir}\" before and after uninstall."
msgstr "Um die Kacheln beizubehalten, benennen Sie das Verzeichnis vor und nach der Deinstallation in „{dir}“ um."

msgid "All media rendered as \"tile\" will be rendered as \"file\"."
msgstr "Alle als „Kachel“ gerenderten Medien werden als „Datei“ gerendert."

msgid "Creating tiles and/or dimensions for images attached to specified items, in background ({link}job #{job_id}{link_end}, {link_log}logs{link_end})."
msgstr "Erstellen von Kacheln und/oder Abmessungen für Bilder, die an bestimmte Elemente angehängt sind, im Hintergrund ({link}Job #{job_id}{link_end}, {link_log}Protokolle{link_end})."

msgid "The option \"auto-tiling\" is not set: it is recommended to enable it once all existing images have been tiled to avoid to tile new images manually."
msgstr "Die Option „Automatisches Kacheln“ ist nicht eingestellt: Es wird empfohlen, sie zu aktivieren, sobald alle vorhandenen Bilder gekachelt wurden, um zu vermeiden, dass neue Bilder manuell gekachelt werden müssen."

msgid "Media #{media_id}: The file \"{filename}\" is missing."
msgstr "Medien #{media_id}: Die Datei „{filename}“ fehlt."

msgid "Media #{media_id}: The tiler failed: {exception}"
msgstr "Medien #{media_id}: Der Kacheler ist fehlgeschlagen: {Ausnahme}"

msgid "Php extension php-xml is not installed"
msgstr "Die PHP-Erweiterung php-xml ist nicht installiert"

msgid "Source is empty."
msgstr "Quelle ist leer."

msgid "Source file \"{file}\" is not readable."
msgstr "Die Quelldatei „{file}“ ist nicht lesbar."

msgid "Destination is empty."
msgstr "Das Ziel ist leer."

msgid "The type of tiling \"{type}\" is not supported by the tile builder."
msgstr "Der Kacheltyp „{type}“ wird vom Kachel-Builder nicht unterstützt."

msgid "No media selected. You may check your query."
msgstr "Kein Medium ausgewählt.Sie können Ihre Anfrage überprüfen."

msgid "The job ended: no tasks (tile or size) defined."
msgstr "Der Job wurde beendet: Keine Aufgaben (Kachel oder Größe) definiert."

msgid "Media #{media_id}: Start tiling ({type})"
msgstr "Medien #{media_id}: Kacheln starten ({type})"

msgid "Media #{media_id}: Skipped because already tiled."
msgstr "Medien #{media_id}: Übersprungen, da bereits gekachelt."

msgid "Media #{media_id}: Renderer \"{renderer}\" updated to \"{renderer_new}\"."
msgstr "Medien #{media_id}: Renderer „{renderer}“ wurde auf „{renderer_new}“ aktualisiert."

msgid "Media #{media_id}: End tiling"
msgstr "Medien #{media_id}: Kachelung beenden"

msgid "Media #{media_id}: Error during tiling"
msgstr "Medien #{media_id}: Fehler beim Kacheln"

msgid "No item selected. You may check your query."
msgstr "Kein Artikel ausgewählt.Sie können Ihre Anfrage überprüfen."

msgid "Starting bulk tile info for {total} items."
msgstr "Beginnende Bulk-Kachelinformationen für {total} Artikel."

msgid "The job \"Bulk Tile Info\" was stopped: {count}/{total} resources processed."
msgstr "Der Job „Bulk Tile Info“ wurde gestoppt: {count}/{total} Ressourcen verarbeitet."

msgid "End of bulk prepare tile info: {count}/{total} items processed, {total_succeed} files sized, {total_failed} errors, {total_skipped} skipped on a total of {total_images} images."
msgstr "Informationen zur Kachel zum Ende der Massenvorbereitung: {count}/{total} Elemente verarbeitet, {total_succeed} Dateien groß, {total_failed} Fehler, {total_skipped} übersprungen bei insgesamt {total_images} Bildern."

msgid "The media to tile cannot be identified."
msgstr "Das zu kachelnde Medium kann nicht identifiziert werden."

msgid "The media file to tile cannot be found."
msgstr "Die zu kachelnde Mediendatei kann nicht gefunden werden."

msgid "An error occurred during the tiling of media #{media_id}."
msgstr "Beim Kacheln des Mediums #{media_id} ist ein Fehler aufgetreten."

msgid "Starting bulk sizing for {total} items ({filter} media)."
msgstr "Beginn der Massengrößenbestimmung für {total} Artikel ({filter} Medien)."

msgid "The job \"Bulk Sizer\" was stopped: {count}/{total} resources processed."
msgstr "Der Job „Bulk Sizer“ wurde gestoppt: {count}/{total} Ressourcen verarbeitet."

msgid "End of bulk sizing: {count}/{total} items processed, {total_succeed} files sized, {total_failed} errors, {total_skipped} skipped on a total of {total_images} images."
msgstr "Ende der Massengrößenbestimmung: {count}/{total} Elemente verarbeitet, {total_succeed} Dateien groß, {total_failed} Fehler, {total_skipped} übersprungen bei insgesamt {total_images} Bildern."

msgid "Starting bulk tiling for %d items."
msgstr "Massenkachelung für %d Elemente wird gestartet."

msgid "The job \"Bulk Tiler\" was stopped: {count}/{total} resources processed."
msgstr "Der Job „Bulk Tiler“ wurde gestoppt: {count}/{total} Ressourcen verarbeitet."

msgid "End of bulk tiling: {count}/{total} items processed, {total_succeed} files tiled, {total_failed} errors, {total_skipped} skipped on a total of {total_images} images."
msgstr "Ende der Massenkachelung: {count}/{total} Elemente verarbeitet, {total_succeed} Dateien gekachelt, {total_failed} Fehler, {total_skipped} übersprungen bei insgesamt {total_images} Bildern."

msgid "Starting bulk tiling or sizing for {total} items."
msgstr "Beginnen Sie mit der Massenkachelung oder Größenanpassung für {total} Artikel."

msgid "The job \"Bulk Tiler and Sizer\" was stopped: {count}/{total} resources processed."
msgstr "Der Job „Bulk Tiler and Sizer“ wurde gestoppt: {count}/{total} Ressourcen verarbeitet."

msgid "Media #{media_id}: Store tile info"
msgstr "Medien #{media_id}: Kachelinformationen speichern"

msgid "Media #{media_id}: Sizing"
