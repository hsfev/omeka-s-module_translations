msgstr "Die Datei im temporären Verzeichnis „tiletmp“, das zum Erstellen von Kacheln auf Amazon S3 erforderlich ist, konnte nicht kopiert werden.Überprüfen Sie die Rechte im lokalen Verzeichnis files/."

msgid "Either a URL"
msgstr "Entweder eine URL"

msgid "A URL to the image. Prefix it with \"file://\" for a local file managed via module Sideload"
msgstr "Eine URL zum Bild.Stellen Sie ihm „file://“ voran, wenn es sich um eine lokale Datei handelt, die über das Modul Sideload verwaltet wird"

msgid "Or a file"
msgstr "Oder eine Datei"

msgid "Error validating \"%s\". The file to tile should be an image, not \"%s\"."
msgstr "Fehler beim Validieren von „%s“.Die zu kachelnde Datei sollte ein Bild sein, nicht „%s“."

msgid "Media \"{media_id}\" not found."
msgstr "Medien „{media_id}“ nicht gefunden."

msgid "The media \"{media_id}\" is not an image"
msgstr "Das Medium „{media_id}“ ist kein Bild"

msgid "The Image server encountered an unexpected error that prevented it from fulfilling the request: the file is not tiled for dynamic processing."
msgstr "Beim Bildserver ist ein unerwarteter Fehler aufgetreten, der die Ausführung der Anforderung verhindert hat: Die Datei ist nicht für die dynamische Verarbeitung vorgesehen."

msgid "The Image server encountered an unexpected error that prevented it from fulfilling the request: the resulting file is not found or empty."
msgstr "Beim Bildserver ist ein unerwarteter Fehler aufgetreten, der die Ausführung der Anforderung verhindert hat: Die resultierende Datei wurde nicht gefunden oder ist leer."

msgid "The Image server encountered an unexpected error that prevented it from fulfilling the request: the resulting file is empty or not found."
msgstr "Beim Bildserver ist ein unerwarteter Fehler aufgetreten, der die Ausführung der Anforderung verhindert hat: Die resultierende Datei ist leer oder wurde nicht gefunden."

msgid "The Image server cannot fulfill the request: the region \"{region}\" is incorrect."
msgstr "Der Bildserver kann die Anfrage nicht erfüllen: Die Region „{region}“ ist falsch."

msgid "The Image server cannot fulfill the request: the region \"{region}\" is  outside the source."
msgstr "Der Bildserver kann die Anfrage nicht erfüllen: Die Region „{region}“ liegt außerhalb der Quelle."

msgid "The Image server cannot fulfill the request: the region \"{region}\" is invalid."
msgstr "Der Bildserver kann die Anfrage nicht erfüllen: Die Region „{region}“ ist ungültig."

msgid "The Image server cannot fulfill the request: the size \"{size}\" is incorrect for API version {version}."
msgstr "Der Bildserver kann die Anfrage nicht erfüllen: Die Größe „{size}“ ist für die API-Version {version} falsch."

msgid "The Image server cannot fulfill the request: the size \"{size}\" is incorrect."
msgstr "Der Bildserver kann die Anfrage nicht erfüllen: Die Größe „{size}“ ist falsch."

msgid "The Image server cannot fulfill the request: the size \"%s\" is incorrect."
msgstr "Der Bildserver kann die Anfrage nicht erfüllen: Die Größe „%s“ ist falsch."

msgid "The Image server cannot fulfill the request: the size \"{size}\" is not supported."
msgstr "Der Bildserver kann die Anfrage nicht erfüllen: Die Größe „{size}“ wird nicht unterstützt."

msgid "The Image server cannot fulfill the request: the size \"{size}\" is invalid."
msgstr "Der Bildserver kann die Anfrage nicht erfüllen: Die Größe „{size}“ ist ungültig."

msgid "The Image server cannot fulfill the request: the region \"{region}\" or size \"{size}\" is incorrect for api version {version}."
msgstr "Der Bildserver kann die Anfrage nicht erfüllen: Die Region „{region}“ oder die Größe „{size}“ ist für die API-Version {version} falsch."

msgid "The Image server cannot fulfill the request: the format \"{format}\" is not supported."
msgstr "Der Bildserver kann die Anfrage nicht erfüllen: Das Format „{format}“ wird nicht unterstützt."

msgid "Automatic (Vips when possible, else GD, else Imagick, else ImageMagick)"
msgstr "Automatisch (Vips wenn möglich, sonst GD, sonst Imagick, sonst ImageMagick)"

msgid "Vips (command line)"
msgstr "Vips (Befehlszeile)"

msgid "GD (php extension)"
msgstr "GD (PHP-Erweiterung)"

msgid "Imagick (php extension)"
msgstr "Imagick (PHP-Erweiterung)"

msgid "ImageMagick (command line)"
msgstr "ImageMagick (Befehlszeile)"
