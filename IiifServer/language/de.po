msgstr "Präfix zur Verwendung für die Kennung (muss derzeit in module.config.php festgelegt werden)"

msgid "Allows to check identifiers that contains \"/\" from \"ark:/12345/xxx\" and \"ark:%2F12345%2Fxxx\" (example: \"ark:/12345/\")."
msgstr "Ermöglicht die Überprüfung von Bezeichnern, die „/“ aus „ark:/12345/xxx“ und „ark:%2F12345%2Fxxx“ enthalten (Beispiel: „ark:/12345/“)."

msgid "Allow raw identifier"
msgstr "Rohkennung zulassen"

