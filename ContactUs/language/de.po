msgid "The contact message doesn’t exist."
msgstr "Die Kontaktnachricht existiert nicht."

msgid "A user has contacted you.\n\nemail: {email}\nname: {name}\nip: {ip}\n\n{newsletter}\nsubject: {subject}\nmessage:\n\n{message}\n\n{fields}"
msgstr "Ein Benutzer hat Sie kontaktiert.\n\nE-Mail: {email}\nName: {Name}\nIP: {ip}\n\n{Newsletter}\nBetreff: {Betreff}\nNachricht:\n\n{Nachricht}\n\n{Felder}"

msgid "Confirmation contact"
msgstr "Bestätigungskontakt"

msgid "Hi {name},\n\nThanks to contact us!\n\nWe will answer you as soon as possible.\n\nSincerely,\n\n{main_title}\n{main_url}\n\n--\n\n{newsletter}\nYour message:\nSubject: {subject}\n\n{message}\n\n{fields}"
msgstr "Hallo {Name},\n\nVielen Dank, dass Sie uns kontaktieren!\n\nWir werden Ihnen so schnell wie möglich antworten.\n\nAufrichtig,\n\n{main_title}\n{main_url}\n\n--\n\n{Newsletter}\nIhre Nachricht:\nBetreff: {Betreff}\n\n{Nachricht}\n\n{Felder}"

msgid "Subscription to newsletter of {main_title}"
msgstr "Abonnement des Newsletters von {main_title}"

msgid "Hi,\n\nThank you for subscribing to our newsletter.\n\nSincerely,"
msgstr "Hallo,\n\nVielen Dank, dass Sie sich für unseren Newsletter angemeldet haben.\n\nAufrichtig,"

msgid "Hi {user_name},\n\nThe visitor {name} ({email} made the following request about a resource on {main_title}:\n\nThanks to reply directly to the email above and do not use \"reply\".\n\nSincerely,\n\n--\n\nFrom: {name} <{email}>\nSubject: {subject}\n\n{message}\n\n{fields}"
msgstr "Hallo {Benutzername},\n\nDer Besucher {name} ({email} hat die folgende Anfrage zu einer Ressource auf {main_title} gestellt:\n\nVielen Dank, dass Sie direkt auf die obige E-Mail antworten und nicht „Antworten“ verwenden.\n\nAufrichtig,\n\n--\n\nVon: {name} <{email}>\nBetreff: {Betreff}\n\n{Nachricht}\n\n{Felder}"

msgid "Thank you for your message. Check your confirmation email sent to {email}. We will answer you soon."
msgstr "Vielen Dank für Ihre Nachricht.Überprüfen Sie Ihre Bestätigungs-E-Mail an {email}.Wir werden Ihnen bald antworten."

msgid "Thank you for subscribing to our newsletter. Check the confirmation email sent to {email}."
msgstr "Vielen Dank, dass Sie sich für unseren Newsletter angemeldet haben.Überprüfen Sie die an {email} gesendete Bestätigungs-E-Mail."

msgid "I allow the site owner to store my name and my email to answer to this message."
msgstr "Ich erlaube dem Seitenbetreiber, meinen Namen und meine E-Mail-Adresse zu speichern, um auf diese Nachricht antworten zu können."

