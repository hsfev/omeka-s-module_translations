msgid "The module %1$s should be upgraded to version %2$s or later."
msgstr "Das Modul %1$s sollte auf Version %2$s oder höher aktualisiert werden."

msgid "The library \"%s\" should be installed."
msgstr "Die Bibliothek „%s“ sollte installiert sein."

msgid "See module’s installation documentation."
msgstr "Siehe Installationsdokumentation des Moduls."

msgid "Last version of Universal Viewer (v4) has been integrated. Check if it works fine with your documents."
msgstr "Die letzte Version von Universal Viewer (v4) wurde integriert.Überprüfen Sie, ob es mit Ihren Dokumenten einwandfrei funktioniert."

msgid "A param in settings (default) and in site settings allows to set the config of Universal Viewer version 4. See {link}documentation{link_end}."
msgstr "Ein Parameter in den Einstellungen (Standard) und in den Site-Einstellungen ermöglicht das Festlegen der Konfiguration von Universal Viewer Version 4. Siehe {link}Dokumentation{link_end}."

msgid "Universal Viewer: Use config file from the theme for v4 (deprecated)"
msgstr "Universal Viewer: Konfigurationsdatei aus dem Theme für Version 4 verwenden (veraltet)"

msgid "Universal Viewer"
msgstr "Universeller Viewer"

msgid "Players"
msgstr "Players"

msgid "Universal viewer: Version"
msgstr "Universeller Viewer: Version"

msgid "Version 2.0.2 (better speed for some scanned pdf; require iiif v2)"
msgstr "Version 2.0.2 (bessere Geschwindigkeit für einige gescannte PDFs; erfordert iiif v2)"

msgid "Version 3.1.1 (more modern, but deprecated)"
msgstr "Version 3.1.1 (moderner, aber veraltet)"

msgid "Version 4 (up to date)"
msgstr "Version 4 (aktuell)"

msgid "Universal viewer: Config as json for v4"
msgstr "Universeller Viewer: Als JSON für Version 4 konfigurieren"

msgid "This json will be merged with the default one generated by the module. Take care of double quotes and commas."
msgstr "Dieser JSON wird mit dem vom Modul generierten Standard-JSON zusammengeführt.Achten Sie auf doppelte Anführungszeichen und Kommas."

msgid "Property supplying an external manifest"
msgstr "Eigenschaft, die ein externes Manifest bereitstellt"

msgid "External or static manifests can be more customized and may be quicker to be loaded. Usually, the property is \"dcterms:hasFormat\" or \"dcterms:isFormatOf\"."
msgstr "Externe oder statische Manifeste können individueller angepasst werden und können möglicherweise schneller geladen werden.Normalerweise ist die Eigenschaft „dcterms:hasFormat“ oder „dcterms:isFormatOf“."

msgid "Select a property…"
msgstr "Wählen Sie eine Immobilie aus…"
