msgstr "Der Pfad „%s“ ist bereits belegt."

msgid "Main"
msgstr "Hauptsächlich"

msgid "Api"
msgstr "API"

msgid "Search index #%d (\"%s\"): there is no resource type to index or the indexation is not needed."
msgstr "Suchindex #%d („%s“): Es gibt keinen zu indizierenden Ressourcentyp oder die Indizierung ist nicht erforderlich."

msgid "Search index #%d (\"%s\"): There are already %d other jobs \"Search Index\" and the current one is not forced."
msgstr "Suchindex #%d (\"%s\"): Es gibt bereits %d andere Jobs \"Suchindex\" und der aktuelle wird nicht erzwungen."

msgid "There are already %d other jobs \"Indexing\". Slowdowns may occur on the site."
